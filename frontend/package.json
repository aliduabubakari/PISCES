{
  "name": "pisces-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/generate-validators.mjs --check",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/generate-validators.mjs",
    "generate:types": "json2ts -i ../src/pisces/schemas/report-view-1.0.0.schema.json -o src/api/generated/report-view.ts --additionalProperties false && json2ts -i ../src/pisces/schemas/campaign-view-1.0.0.schema.json -o src/api/generated/campaign-view.ts --additionalProperties false",
    "build": "tsc --noEmit && vite build",
    "test": "node scripts/generate-validators.mjs --check && vitest run src/test",
    "generate:validators": "node scripts/generate-validators.mjs",
    "test:e2e": "playwright test",
    "generate:jobs": "json2ts -i ../src/pisces/schemas/jobs-1.0.0.schema.json -o src/api/generated/jobs.ts --additionalProperties false --ignoreMinAndMaxItems",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "ajv": "8.20.0",
    "lucide-react": "1.77.0",
    "prismjs": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "2.1.9",
    "recharts": "3.11.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
