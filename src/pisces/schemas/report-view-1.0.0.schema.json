{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReportView",
  "type": "object",
  "additionalProperties": false,
  "required": ["view_schema_version", "metric_registry_version", "report_id", "report_kind", "source_schema_version", "admission", "identity", "execution", "outputs", "tasks", "metrics", "comparison", "warnings"],
  "properties": {
    "view_schema_version": {"const": "1.0.0"},
    "metric_registry_version": {"const": "1.0.0"},
    "report_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "report_kind": {"enum": ["unified", "suite_attempt", "unsupported"]},
    "source_schema_version": {"type": ["string", "null"]},
    "admission": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["current_inventory", "suite_inventory", "legacy_inventory", "rejected", "unsupported"]},
        "reason": {"type": ["string", "null"]}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "engine", "case", "artifact_sha256", "evidence_kind"],
      "properties": {
        "name": {"type": "string"}, "engine": {"type": "string"},
        "case": {"type": ["string", "null"]},
        "artifact_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "evidence_kind": {"type": "string"}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "pointer"],
      "properties": {"status": {"type": "string"}, "pointer": {"type": ["string", "null"]}}
    },
    "outputs": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "checks", "expected_behavior_matched"],
      "properties": {
        "status": {"type": "string"},
        "expected_behavior_matched": {"type": ["boolean", "null"]},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/output"}}
      }
    },
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}},
    "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["resource_eligible", "pairwise_status", "screening_eligible", "reasons", "pointer"],
      "properties": {
        "resource_eligible": {"type": ["boolean", "null"]},
        "pairwise_status": {"type": "string"},
        "screening_eligible": {"type": ["boolean", "null"]},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "pointer": {"type": ["string", "null"]}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "status", "passed", "row_count", "reason", "pointer"],
      "properties": {
        "name": {"type": "string"}, "status": {"type": "string"},
        "passed": {"type": ["boolean", "null"]},
        "row_count": {"type": ["integer", "null"], "minimum": 0},
        "reason": {"type": ["string", "null"]}, "pointer": {"type": "string"}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "state", "status", "pointer"],
      "properties": {
        "task_id": {"type": "string"}, "state": {"type": "string"},
        "status": {"type": "string"}, "pointer": {"type": "string"}
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "value", "raw_value", "unit", "raw_unit", "scope", "definition", "source", "includes", "availability", "reason_codes", "pointer", "evidence_role"],
      "properties": {
        "id": {"type": "string"}, "label": {"type": "string"},
        "value": {"type": ["number", "null"], "minimum": 0},
        "raw_value": {"type": ["number", "null"], "minimum": 0},
        "unit": {"type": "string"}, "raw_unit": {"type": "string"},
        "scope": {"type": "string"}, "definition": {"type": "string"},
        "source": {"type": "string"}, "includes": {"type": "string"},
        "availability": {"enum": ["available", "unavailable", "invalid", "not_collected"]},
        "reason_codes": {"type": "array", "items": {"type": "string"}},
        "pointer": {"type": ["string", "null"]},
        "evidence_role": {"enum": ["reported", "diagnostic", "modeled"]}
      }
    }
  }
}
