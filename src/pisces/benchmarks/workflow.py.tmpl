import csv
from datetime import datetime, timezone
from decimal import Decimal
from itertools import groupby
import json
from pathlib import Path

PIPELINE = __PIPELINE__
VARIANT = __VARIANT__
CONFIG = __CONFIG__


def read_csv(name):
    with (Path("inputs") / (name + ".csv")).open(encoding="utf-8", newline="") as stream:
        return list(csv.DictReader(stream))


def normalize():
    Path("work").mkdir(exist_ok=True)
    rows = []
    rejected = 0
    if PIPELINE == "climate_fusion":
        for source in CONFIG["sources"]:
            if VARIANT != "equivalent":
                read_csv(source)
            for row in read_csv(source):
                value = Decimal(row["temperature"])
                if row["unit"] == "F":
                    value = (value - 32) * 5 / 9
                rows.append([source, int(row["station_id"]), format(value, ".2f")])
    elif PIPELINE == "event_aggregation":
        for row in read_csv("events"):
            if row["status"] != "valid":
                rejected += 1
            else:
                rows.append([int(row["group_id"]), int(row["amount"])])
    elif PIPELINE == "order_enrichment":
        customers = read_csv("customers")
        if VARIANT == "equivalent":
            from bisect import bisect_left
            customers.sort(key=lambda row: int(row["customer_id"]))
            keys = [int(row["customer_id"]) for row in customers]

            def lookup(key):
                index = bisect_left(keys, key)
                return customers[index] if index < len(keys) and keys[index] == key else None
        else:
            mapping = {int(row["customer_id"]): row for row in customers}
            lookup = mapping.get
        for row in read_csv("orders"):
            customer = lookup(int(row["customer_id"]))
            if customer is None:
                rejected += 1
            else:
                net = int(row["quantity"]) * int(row["unit_cents"]) * (10000 - int(customer["discount_bps"])) // 10000
                rows.append([int(row["order_id"]), customer["region"], net])
    elif PIPELINE == "sensor_windows":
        for row in read_csv("readings"):
            if row["quality"] != "good":
                rejected += 1
            else:
                rows.append([int(row["sensor_id"]), int(row["timestamp_s"]) // 60 * 60, int(row["temperature_tenths"])])
    elif PIPELINE == "inventory_latest":
        rows = [[int(row["item_id"]), int(row["version"]), int(row["quantity"]), row["deleted"] == "true"]
                for row in read_csv("updates")]
    Path("work/normalized.json").write_text(json.dumps({"rows": rows, "rejected": rejected}), encoding="utf-8")


def transform():
    data = json.loads(Path("work/normalized.json").read_text(encoding="utf-8"))
    rows = data["rows"]
    accepted = len(rows)
    if PIPELINE in {"event_aggregation", "sensor_windows"}:
        width = 1 if PIPELINE == "event_aggregation" else 2
        if VARIANT == "equivalent":
            rows.sort(key=lambda row: row[:width])
            result = []
            for key, group in groupby(rows, key=lambda row: tuple(row[:width])):
                members = list(group)
                result.append([*key, len(members), sum(row[-1] for row in members)])
        else:
            groups = {}
            for row in rows:
                value = groups.setdefault(tuple(row[:width]), [0, 0])
                value[0] += 1
                value[1] += row[-1]
            result = [[*key, *value] for key, value in groups.items()]
    elif PIPELINE == "inventory_latest":
        if VARIANT == "equivalent":
            rows.sort(key=lambda row: (row[0], -row[1]))
            latest = [next(group) for _, group in groupby(rows, key=lambda row: row[0])]
        else:
            groups = {}
            for row in rows:
                if row[0] not in groups or row[1] > groups[row[0]][1]:
                    groups[row[0]] = row
            latest = list(groups.values())
        result = [[item, version, quantity, not deleted] for item, version, quantity, deleted in latest]
    else:
        result = rows
        if VARIANT == "equivalent":
            result.reverse()
    result.sort(key=lambda row: tuple(row[index] for index in CONFIG["key_indices"]))
    if VARIANT == "same_shape_wrong":
        index = CONFIG["value_index"]
        value = result[0][index]
        result[0][index] = str(Decimal(value) + 1) if isinstance(value, str) else value + 1
    Path("work/result.json").write_text(json.dumps({
        "rows": result, "quality": [["accepted_count", accepted], ["rejected_count", data["rejected"]]],
    }), encoding="utf-8")


def write_outputs():
    data = json.loads(Path("work/result.json").read_text(encoding="utf-8"))
    Path("outputs").mkdir(exist_ok=True)
    for name, header, rows in (("result", CONFIG["header"], data["rows"]), ("quality", ["metric", "value"], data["quality"])):
        if VARIANT == "partial" and name == "quality":
            continue
        with (Path("outputs") / (name + ".csv")).open("w", encoding="utf-8", newline="") as stream:
            writer = csv.writer(stream)
            writer.writerow(header)
            writer.writerows([[str(value).lower() if isinstance(value, bool) else value for value in row] for row in rows])


if __name__ == "__main__":
    normalize()
    transform()
    write_outputs()
else:
__ENGINE_ENTRYPOINT__
