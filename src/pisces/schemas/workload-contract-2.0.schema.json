{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "contract_id", "pipeline_id", "functional_unit", "inputs", "outputs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2.0"},
    "contract_id": {"type": "string", "minLength": 1},
    "pipeline_id": {"type": "string", "minLength": 1},
    "functional_unit": {"const": "valid_batch"},
    "fixed_logical_date": {"type": "string"},
    "inputs": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["integration_id", "kind", "fixture", "sha256"],
      "properties": {
        "integration_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["file", "http", "ftp"]},
        "fixture": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }},
    "service_effects": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["integration_id", "served_count"],
      "properties": {
        "integration_id": {"$ref": "#/$defs/id"},
        "served_count": {"type": "integer", "minimum": 1}
      }
    }},
    "outputs": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["logical_name", "format", "columns", "primary_key", "row_order", "reference"],
      "properties": {
        "logical_name": {"$ref": "#/$defs/id"},
        "format": {"const": "csv"},
        "primary_key": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "row_order": {"enum": ["ignore", "exact", "key_sorted"]},
        "reference": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}
        },
        "columns": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "type", "nullable"],
          "properties": {
            "name": {"$ref": "#/$defs/id"},
            "type": {"enum": ["string", "integer", "decimal", "boolean"]},
            "nullable": {"type": "boolean"},
            "unit": {"type": "string", "minLength": 1},
            "absolute_tolerance": {"type": "number", "minimum": 0}
          }
        }}
      }
    }}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
